<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- push notifications; archives for TestFlight/App Store get the production value -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple (server/appleid.js) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- invite links (/?add=) open the app; the site serves apple-app-site-association (server/applinks.js) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.thedailies.lol</string>
		<string>webcredentials:www.thedailies.lol</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.lol.thedailies</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)lol.thedailies.shared</string>
	</array>
</dict>
</plist>
